#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * Corne(crkbd) v3 — Lily58 키맵 이식본
 *
 * Layer 순서 (기존 인덱스 유지):
 * 0: default            기본 QWERTY
 * 1: mouse              마우스 이동/클릭/스크롤
 * 2: num_nav            숫자패드 + 내비게이션
 * 3: function           F키 + 숫자열 대체
 * 4: system             BT/출력/전원/미디어
 * 5: numpad_blender     블렌더용 넘패드
 * 6: shift_ctrl_change  좌측 Shift/Ctrl 스왑 (tog)
 *
 * 레이어 진입 키(mo/lt)는 배치가 애매해서 base에서 제외.
 * ZMK Studio에서 직접 할당할 것.
 */

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <75>;
            flavor = "balanced";
            hold-trigger-on-release;

            /* Corne 42키 기준: 오른쪽 절반 + 오른쪽 썸 */

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <75>;
            flavor = "balanced";
            hold-trigger-on-release;

            /* Corne 42키 기준: 왼쪽 절반 + 왼쪽 썸 */

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        td_tab2capslock: td_tab2capslock {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TAB2CAPSLOCK";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp TAB>, <&caps_word>;
        };

        ltbspc: ltbspc {
            compatible = "zmk,behavior-hold-tap";
            label = "LTBSPC";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
        };

        mouse_toggle: mouse_toggle {
            compatible = "zmk,behavior-tap-dance";
            label = "MOUSE_TOGGLE";
            #binding-cells = <0>;
            bindings = <&mo 5>, <&tog 1>;
        };

        sifht_ctrl_change: sifht_ctrl_change {
            compatible = "zmk,behavior-tap-dance";
            label = "SIFHT_CTRL_CHANGE";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 0>;
        };

        space_lt: space_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
        };
    };

    /*
     * Corne 42키 포지션:
     *  0.. 5 |  6..11
     * 12..17 | 18..23
     * 24..29 | 30..35
     *   36 37 38 | 39 40 41
     */

    combos {
        compatible = "zmk,combos";

        hangul {
            bindings = <&kp LANG_HANGEUL>;
            key-positions = <20 21>;    /* K + L */
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;    /* A + S */
        };

        system {
            bindings = <&mo 4>;
            key-positions = <37 36>;
        };

        tabs {
            bindings = <&kp TAB>;
            key-positions = <0 2>;
        };

        numpad {
            bindings = <&sl 5>;
            key-positions = <38 37>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <2 3>;
        };

        lshift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <13 14>;
        };

        lalt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <16 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ------------------------------------------------------
         * Base
         * ------------------------------------------------------
         *
         * TAB  Q  W  E  R  T        Y  U  I  O  P  -
         * CTL  A  S  D  F  G        H  J  K  L  ;  '
         * SFT  Z  X  C  V  B        N  M  ,  .  /  SFT
         *
         *      ALT GUI SPACE    ENTER BSPC DEL
         */

        default_layer {
            display-name = "Base";
            bindings = <
&trans  &kp Q  &kp W  &kp E      &kp R               &kp T                &kp Y                 &kp U          &kp I         &kp O    &kp P       &trans
&trans  &kp A  &kp S  &kp D      &kp F               &kp G                &kp H                 &kp J          &kp K         &kp L    &lt 2 APOS  &trans
&trans  &kp Z  &kp X  &kp C      &kp V               &kp B                &kp N                 &kp M          &kp COMMA     &kp DOT  &kp FSLH    &trans
                      &kp LCTRL  &mt LEFT_GUI ENTER  &space_lt 2 SPACE    &mt LEFT_SHIFT SPACE  &kp BACKSPACE  &lt 3 DELETE
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans    &trans     &trans          &trans        &trans      &kp LC(Y)  &mkp MB4        &mmv MOVE_UP    &mkp MB5         &kp LC(C)        &kp LC(Z)
&trans  &mkp MB4  &mkp RCLK  &mkp MCLK       &mkp LCLK     &mkp MB5    &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none            &none
&trans  &trans    &trans     &msc SCRL_DOWN  &msc SCRL_UP  &trans      &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT  &trans
                             &trans          &trans        &trans      &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;
        };

        num_nav {
            display-name = "NumNav";
            bindings = <
&trans  &kp N6    &kp N7    &kp N8      &kp N9     &kp N0       &kp HOME   &kp END         &kp UP_ARROW    &kp PAGE_DOWN    &kp PAGE_UP  &trans
&trans  &kp N1    &kp N2    &kp N3      &kp N4     &kp N5       &kp INS    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans       &trans
&trans  &kp LBKT  &kp RBKT  &kp BSLH    &kp MINUS  &kp EQUAL    &kp GRAVE  &kp APOS        &trans          &trans           &trans       &trans
                            &kp KP_DOT  &kp DOT    &trans       &trans     &trans          &trans
            >;
        };

        function {
            display-name = "Fn";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN    &kp N6    &kp N7    &kp N8    &kp N9     &kp N0     &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK     &kp N1    &kp N2    &kp N3    &kp N4     &kp N5     &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK    &kp LBKT  &kp RBKT  &kp BSLH  &kp MINUS  &kp EQUAL  &trans
                         &trans  &trans  &trans             &trans    &trans    &trans
            >;
        };

        system {
            display-name = "System";
            bindings = <
&trans  &out OUT_USB  &out OUT_BLE  &trans        &trans             &bt BT_CLR          &trans            &trans          &kp C_VOL_UP  &trans      &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3       &bt BT_SEL 4        &trans            &kp C_PREVIOUS  &kp C_VOL_DN  &kp C_NEXT  &trans  &trans
&trans  &trans        &trans        &trans        &ext_power EP_OFF  &ext_power EP_ON    &trans            &trans          &kp K_MUTE    &trans      &trans  &trans
                                    &trans        &trans             &kp C_PP            &kp C_PLAY_PAUSE  &trans          &trans
            >;
        };

        numpad_blender {
            display-name = "Numpad";
            bindings = <
&trans  &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DOT      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp KP_PLUS     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp HOME        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp KP_MINUS    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SLASH    &trans  &trans  &trans  &trans  &trans  &trans
                                         &kp KP_NUMBER_0  &trans           &trans          &trans  &trans  &trans
            >;
        };
    };
};
